#!name=七麦数据增强
#!desc=七麦数据增强
#!icon=https://raw.githubusercontent.com/Arkove/ProxyKit/main/icons/qimai.png

#############################################

[Rewrite]
^https?:\/\/(?>webapi|miniapp)\.qmai\.cn\/web\/cmk-center\/marketing\/canvas\/advert reject

[Script]
http-response ^https?:\/\/(?>webapi|miniapp)\.qmai\.cn\/web\/catering([0-9]-apiserver)?\/advertising\/ad\/advertiseInfo script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/qmai.js, requires-body=true, timeout=60, tag=企迈（挪瓦咖啡、林里柠檬茶、霸王茶姬、陈香贵）

[MITM]
hostname = webapi.qmai.cn, miniapp.qmai.cn
